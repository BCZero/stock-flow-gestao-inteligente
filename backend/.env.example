# Modelo de configuração local do backend.
# Copie para backend/.env (não versionado) e ajuste:  copy .env.example .env
# A API e o Alembic leem backend/.env automaticamente (app/core/config.py),
# então não é preciso definir $env:DATABASE_URL a cada terminal.
#
# Atenção: use apenas as variáveis listadas aqui. Qualquer outra chave
# no .env faz a API recusar a inicialização ("Extra inputs are not permitted").

# Banco usado pela API. Deixe apenas UMA linha DATABASE_URL ativa e reinicie o backend.
# Banco principal (cadastro próprio, via gerenciar_usuario.py)
DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/stockflow_db
# Banco de demonstração (carga de popular_demo.py: emporio@stockflow.test / mercearia@stockflow.test)
# DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/stockflow_demo

# Assinatura dos tokens JWT. Troque por um valor aleatório fora do ambiente de estudo.
# SECRET_KEY=troque-por-um-valor-aleatorio
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitor de alertas (segundos). 0 desativa o agendador automático.
# ALERTAS_INTERVALO_SEGUNDOS=900

# Resumo opcional por LLM (exemplo com Ollama local)
# LLM_PROVIDER=ollama
# LLM_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_TIMEOUT_SEGUNDOS=120
